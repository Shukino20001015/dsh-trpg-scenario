    "scenario-store.js",
    "snapshot-store.js",
    "stage-graph.js",
    "stage-store.js",
    "stage-tool.js",
    "stage-install.js",
    "stage-history.js",
    "character-state.js",
    "character-store.js",
    "character-tool.js",
    "frozen-segment-prepare.mjs",
    "segmented-judge.mjs",
    "segmented-judge-llm.mjs",
    "segmented-global-review.mjs",
    "global-judge-llm.mjs",
    "segmented-pipeline.mjs",
    "judge-log.js",
    "score-audit.js",
    "judge-report.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "MARKED-LICENSE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
